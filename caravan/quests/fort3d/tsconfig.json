{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "lib": ["ES2020", "DOM"],
    "types": [],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"]
}
